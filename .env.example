# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key. AI Studio automatically injects this at runtime from user secrets.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional External Data Providers:
# BudgetBites includes full offline Room database seed for Vasai.
# To connect remote Supabase or Google Places for continuous external scraping:
# GOOGLE_PLACES_API_KEY=AIzaSy...
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
